{
  "name": "report-photo-organizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 9015 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "node --experimental-strip-types server/app.ts",
    "start": "node --experimental-strip-types server/app.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src shared server tests docs validation index.html *.json *.md *.config.ts pnpm-workspace.yaml",
    "format:check": "prettier --check src shared server tests docs validation index.html *.json *.md *.config.ts pnpm-workspace.yaml"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "heic-to": "1.6.5",
    "jspdf": "4.2.1",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/qrcode": "1.5.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
